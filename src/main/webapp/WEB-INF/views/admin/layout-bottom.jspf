        </div>
    </main>
</div>

<script src="${ctx}/js/admin.js"></script>
<%@ include file="/WEB-INF/views/components/loading.jsp" %>

<!-- ACCIONES RÁPIDAS FLOTANTES -->
<div class="acciones-flotantes-admin">

    <div class="acciones-menu">

        <!-- CREAR RESERVA -->
        <a href="${base}/reservas?abrir=nueva" class="accion-flotante-item">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2"/>
                <path d="M8 3v4"/>
                <path d="M16 3v4"/>
                <path d="M3 10h18"/>
                <path d="M12 13v5"/>
                <path d="M9.5 15.5h5"/>
            </svg>

            <span>Crear reserva</span>
        </a>

        <!-- AGREGAR CLIENTE -->
        <a href="${base}/clientes?abrir=nuevo" class="accion-flotante-item">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="9" cy="8" r="3"/>
                <path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/>
                <path d="M17 9v6"/>
                <path d="M14 12h6"/>
            </svg>

            <span>Agregar cliente</span>
        </a>

        <!-- RESERVAS PENDIENTES -->
        <a href="${base}/reservas?estado=PENDIENTE" class="accion-flotante-item">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2"/>
                <path d="M8 3v4"/>
                <path d="M16 3v4"/>
                <path d="M3 10h18"/>
                <path d="M12 13v4"/>
                <path d="M12 19h.01"/>
            </svg>

            <span>Reservas pendientes</span>
        </a>

        <!-- RESERVAS DE HOY -->
        <a href="${base}/disponibilidad?ir=hoy"
           class="accion-flotante-item">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2"/>
                <path d="M8 3v4"/>
                <path d="M16 3v4"/>
                <path d="M3 10h18"/>
                <circle cx="12" cy="15" r="2"/>
            </svg>

            <span>Reservas de hoy</span>
        </a>

    </div>

    <!-- BOTÓN PRINCIPAL -->
    <button type="button"
            class="boton-flotante-admin"
            id="botonAccionesAdmin"
            aria-label="Abrir acciones rápidas"
            aria-expanded="false">

        <img src="${pageContext.request.contextPath}/img/logoAlojamientosGuaviyu.png" alt="Acciones rápidas">
    </button>
</div>

<script>
    const botonAccionesAdmin = document.getElementById("botonAccionesAdmin");
    const accionesFlotantes = document.querySelector(".acciones-flotantes-admin");

    if (botonAccionesAdmin && accionesFlotantes) {
        botonAccionesAdmin.addEventListener("click", () => {
            accionesFlotantes.classList.toggle("abierto");

            const abierto = accionesFlotantes.classList.contains("abierto");

            botonAccionesAdmin.setAttribute("aria-expanded",abierto);
        });
    }
</script>

<script src="${pageContext.request.contextPath}/js/loading.js"></script>
</body>
</html>
